from __future__ import annotations

import json
import logging
import os
from pathlib import Path
import shutil
import subprocess
import sys

APP_NAME = "ansible"
APP_DIR_ENV = "ANSIBLE_DIR"
DEFAULT_APP_DIR = "var/tmp/ansible"
OS_ENV_PREFIX = "ANS_VAR"
STANDARD_ENV_VARS = (
    "JOB_INSTANCE_ID",
    "SCHEDULE_ID",
    "RUN_ID",
    "RESOURCE_TYPE",
    "METHOD",
    "PHASE",
)

logger = logging.getLogger("config0")


def configure_logging() -> None:
    level_name = os.environ.get("ED_LOGLEVEL", "INFO").upper()
    level = getattr(logging, level_name, logging.INFO)
    logging.basicConfig(
        level=level,
        stream=sys.stdout,
        format="%(levelname)s %(message)s",
    )


def require_stateful_id() -> str:
    stateful_id = os.environ.get("STATEFUL_ID")
    if not stateful_id:
        raise RuntimeError("class var stateful_id must be set")
    return stateful_id


def validate_stateful_dir(stateful_id: str) -> str | None:
    stateful_dir = os.environ.get("STATEFUL_DIR")
    if not stateful_dir:
        return None

    normalized = os.path.normpath(stateful_dir)
    stateful_dir_id = os.path.basename(normalized)
    if stateful_dir_id != stateful_id:
        raise ValueError(
            f"STATEFUL_DIR basename {stateful_dir_id!r} does not match "
            f"stateful_id {stateful_id!r}"
        )
    return normalized


def ansible_app_dir() -> str:
    app_dir = os.environ.get(APP_DIR_ENV)
    if not app_dir:
        app_dir = DEFAULT_APP_DIR
    if app_dir.startswith("/"):
        app_dir = app_dir[1:]
    return app_dir


def runtime_root() -> str:
    for env_name in ("CHROOTFILES_DEST_DIR", "STATEFUL_DIR", "EXEC_BASE_DIR"):
        value = os.environ.get(env_name)
        if value:
            return os.path.normpath(value)
    raise RuntimeError(
        "one of CHROOTFILES_DEST_DIR, STATEFUL_DIR, or EXEC_BASE_DIR must be set"
    )


def resolve_exec_dir() -> str:
    exec_dir = os.path.join(runtime_root(), ansible_app_dir())
    Path(exec_dir).mkdir(parents=True, exist_ok=True)
    return exec_dir


def parse_set_env_vars(env_vars: tuple[str, ...]) -> dict[str, str | bool]:
    inputargs: dict[str, str | bool] = {}
    for env_var in env_vars:
        raw = os.environ.get(env_var.upper())
        if not raw:
            continue
        if raw == "None":
            continue
        if raw == "False":
            inputargs[env_var.lower()] = False
            continue
        inputargs[env_var.lower()] = raw
    return inputargs


def ansible_env_inputargs() -> dict[str, str]:
    split_key = f"{OS_ENV_PREFIX}_"
    inputargs: dict[str, str] = {}
    for env_name, value in os.environ.items():
        if OS_ENV_PREFIX not in env_name:
            continue
        parts = env_name.split(split_key)
        if len(parts) < 2:
            raise ValueError(
                f"environment variable {env_name!r} contains {OS_ENV_PREFIX!r} "
                f"but not {split_key!r}"
            )
        inputargs[parts[1].lower()] = value
    return inputargs


def merge_missing(target: dict[str, object], source: dict[str, object]) -> None:
    for key, value in source.items():
        if key in target:
            continue
        target[key] = value


def load_json_input(json_input: str) -> dict[str, object]:
    try:
        parsed = json.loads(json_input)
    except json.JSONDecodeError as exc:
        raise SystemExit(13) from exc
    if not isinstance(parsed, dict):
        raise SystemExit(13)
    return parsed


def resolve_method(inputargs: dict[str, object]) -> object:
    if "method" in inputargs:
        return inputargs["method"]
    return "create"


class Main:
    """Run authored Ansible playbooks on the current host."""

    def __init__(self) -> None:
        self.classname = "AnsibleWrapper"
        self.stateful_id = require_stateful_id()
        validate_stateful_dir(self.stateful_id)
        self.exec_dir = resolve_exec_dir()
        self.inputargs: dict[str, object] = {}
        logger.debug("Instantiating %s", self.classname)

    @staticmethod
    def _install_ansible_core() -> str:
        ansible_playbook = shutil.which("ansible-playbook")
        if ansible_playbook:
            return ansible_playbook

        apt_get = shutil.which("apt-get")
        if not apt_get:
            raise RuntimeError("apt-get is required to install ansible-core")

        apt_env = os.environ.copy()
        apt_env["DEBIAN_FRONTEND"] = "noninteractive"
        subprocess.run([apt_get, "update", "-q"], check=True, env=apt_env)
        subprocess.run(
            [apt_get, "install", "-y", "-q", "ansible-core"],
            check=True,
            env=apt_env,
        )

        ansible_playbook = shutil.which("ansible-playbook")
        if not ansible_playbook:
            raise RuntimeError(
                "ansible-core installation did not provide ansible-playbook"
            )
        return ansible_playbook

    @staticmethod
    def _extra_vars() -> list[str]:
        extra_vars: dict[str, object] = {}
        for env_name, value in sorted(os.environ.items()):
            if not env_name.startswith("ANS_VAR_"):
                continue
            name = env_name.removeprefix("ANS_VAR_")
            if not name:
                raise ValueError("ANS_VAR_ must include a variable name")
            if value[:1] in {"[", "{"}:
                extra_vars[name] = json.loads(value)
            else:
                extra_vars[name] = value
        return ["-e", json.dumps(extra_vars)]

    @staticmethod
    def _exec_ymls() -> list[str]:
        value = os.environ.get("ANS_VAR_exec_ymls")
        if not value:
            raise RuntimeError("ANS_VAR_exec_ymls is required")

        exec_ymls = [entry.strip() for entry in value.split(",")]
        if any(not entry for entry in exec_ymls):
            raise ValueError("ANS_VAR_exec_ymls contains an empty playbook name")
        return exec_ymls

    def set_inputargs(
        self, *, json_input: str | None = None, add_app_vars: bool = False
    ) -> None:
        if json_input:
            merge_missing(self.inputargs, load_json_input(json_input))

        if add_app_vars:
            merge_missing(self.inputargs, ansible_env_inputargs())

        merge_missing(self.inputargs, parse_set_env_vars(STANDARD_ENV_VARS))
        for key, value in list(self.inputargs.items()):
            if value == "False":
                self.inputargs[key] = False

    def create(self) -> None:
        ansible_dir = Path(self.exec_dir)
        exec_ymls = self._exec_ymls()

        for exec_yml in exec_ymls:
            if not (ansible_dir / exec_yml).is_file():
                raise FileNotFoundError(
                    f"Ansible playbook does not exist: {ansible_dir / exec_yml}"
                )

        ansible_playbook = self._install_ansible_core()
        extra_vars = self._extra_vars()
        ansible_env = os.environ.copy()
        ansible_env["ANSIBLE_HOST_PATTERN_MISMATCH"] = "error"

        for exec_yml in exec_ymls:
            subprocess.run(
                [
                    ansible_playbook,
                    "-i",
                    "localhost,",
                    "-c",
                    "local",
                    exec_yml,
                    *extra_vars,
                ],
                check=True,
                cwd=ansible_dir,
                env=ansible_env,
            )


def usage() -> None:
    print(
        """
script + environmental variables

or

script + json_input (as argument)

environmental variables:

    STATEFUL_ID
    METHOD=create
    ANS_VAR_exec_ymls=entry_point/playbook.yml[,entry_point/next.yml]
    ANS_VAR_<name>=<value>
"""
    )
    raise SystemExit(4)


if __name__ == "__main__":
    configure_logging()
    try:
        json_input_arg = sys.argv[1]
    except IndexError:
        json_input_arg = None

    main = Main()
    if json_input_arg:
        main.set_inputargs(json_input=json_input_arg)
    else:
        main.set_inputargs(add_app_vars=True)

    method = resolve_method(main.inputargs)
    if method != "create":
        print(f'method "{method}" not supported!')
        usage()

    main.create()
