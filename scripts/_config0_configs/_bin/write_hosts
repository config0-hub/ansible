from __future__ import annotations

import logging
import os
from pathlib import Path
import sys

APP_DIR_ENV = "ANSIBLE_DIR"
DEFAULT_APP_DIR = "var/tmp/ansible"
OS_ENV_PREFIX = "ANS_VAR"
STANDARD_ENV_VARS = (
    "JOB_INSTANCE_ID",
    "SCHEDULE_ID",
    "RUN_ID",
    "RESOURCE_TYPE",
    "METHOD",
    "PHASE",
)

logger = logging.getLogger("config0")


def configure_logging() -> None:
    level_name = os.environ.get("ED_LOGLEVEL", "INFO").upper()
    level = getattr(logging, level_name, logging.INFO)
    logging.basicConfig(
        level=level,
        stream=sys.stdout,
        format="%(levelname)s %(message)s",
    )


def require_workspace_id() -> str:
    workspace_id = os.environ.get("WORKSPACE_ID")
    if not workspace_id:
        raise RuntimeError("class var WORKSPACE_ID must be set")
    return workspace_id


def ansible_app_dir() -> str:
    app_dir = os.environ.get(APP_DIR_ENV)
    if not app_dir:
        app_dir = DEFAULT_APP_DIR
    if app_dir.startswith("/"):
        app_dir = app_dir[1:]
    return app_dir


def runtime_root() -> str:
    for env_name in ("CHROOTFILES_DEST_DIR", "EXEC_BASE_DIR"):
        value = os.environ.get(env_name)
        if value:
            return os.path.normpath(value)
    raise RuntimeError("one of CHROOTFILES_DEST_DIR or EXEC_BASE_DIR must be set")


def resolve_exec_dir() -> str:
    exec_dir = os.path.join(runtime_root(), ansible_app_dir())
    Path(exec_dir).mkdir(parents=True, exist_ok=True)
    return exec_dir


def parse_set_env_vars(env_vars: tuple[str, ...]) -> dict[str, str | bool]:
    inputargs: dict[str, str | bool] = {}
    for env_var in env_vars:
        raw = os.environ.get(env_var.upper())
        if not raw:
            continue
        if raw == "None":
            continue
        if raw == "False":
            inputargs[env_var.lower()] = False
            continue
        inputargs[env_var.lower()] = raw
    return inputargs


def ansible_env_inputargs() -> dict[str, str]:
    split_key = f"{OS_ENV_PREFIX}_"
    inputargs: dict[str, str] = {}
    for env_name, value in os.environ.items():
        if OS_ENV_PREFIX not in env_name:
            continue
        parts = env_name.split(split_key)
        if len(parts) < 2:
            raise ValueError(
                f"environment variable {env_name!r} contains {OS_ENV_PREFIX!r} "
                f"but not {split_key!r}"
            )
        inputargs[parts[1].lower()] = value
    return inputargs


def merge_missing(target: dict[str, object], source: dict[str, object]) -> None:
    for key, value in source.items():
        if key in target:
            continue
        target[key] = value


def remap_app_vars(inputargs: dict[str, object]) -> None:
    split_char = f"{OS_ENV_PREFIX}_"
    add_values: dict[str, object] = {}
    keys_to_delete: list[str] = []

    for key, value in inputargs.items():
        if split_char not in key:
            continue
        mapped_key = key.split(split_char)[-1]
        add_values[mapped_key] = value
        keys_to_delete.append(key)
        logger.debug("mapped key %s value %s", key, value)

    inputargs.update(add_values)
    for key_to_delete in keys_to_delete:
        del inputargs[key_to_delete]


def resolve_method(inputargs: dict[str, object]) -> object:
    if "method" in inputargs:
        return inputargs["method"]
    return "create"


class Main:
    """
    Main class for managing Ansible host configurations.
    """

    def __init__(self) -> None:
        """
        Initializes the Main class with necessary configurations.
        """
        self.classname = "ANSIBLE_HOSTS"
        self.workspace_id = require_workspace_id()
        self.exec_dir = resolve_exec_dir()
        self.inputargs: dict[str, object] = {}
        logger.debug("Instantiating %s", self.classname)
        self.set_inputargs(add_app_vars=True)
        remap_app_vars(self.inputargs)

    def set_inputargs(self, *, add_app_vars: bool = False) -> None:
        if add_app_vars:
            merge_missing(self.inputargs, ansible_env_inputargs())
        merge_missing(self.inputargs, parse_set_env_vars(STANDARD_ENV_VARS))
        for key, value in list(self.inputargs.items()):
            if value == "False":
                self.inputargs[key] = False

    def check_required_inputargs(self, *, keys: list[str]) -> bool:
        required_keys = [key for key in keys if key not in self.inputargs]
        if not required_keys:
            return True

        found = list(self.inputargs.keys())
        logger.error("These keys missing and need to be set:")
        logger.error("\tkeys found include: %s", found)
        for key in required_keys:
            logger.error(
                "\t%s or Environmental Variable %s/%s_%s",
                key,
                key.upper(),
                OS_ENV_PREFIX,
                key,
            )
        raise SystemExit(9)

    def create(self) -> None:
        """
        Creates a hosts file with the specified IP addresses.
        Retrieves IPs from input arguments and writes them to a file.
        """
        filepath = f"{self.exec_dir}/hosts"

        host_ips = self.inputargs["host_ips"]
        if not isinstance(host_ips, str):
            raise TypeError("host_ips must be a comma-separated string")
        ips = host_ips.split(",")
        if not ips:
            return

        with open(filepath, "w", encoding="utf-8") as host_file:
            for ip_address in ips:
                host_file.write(f"{ip_address}\n")
            host_file.write("\n")

        logger.debug("%s", "#" * 32)
        logger.debug("host ips file written to %s", filepath)
        logger.debug("%s", "#" * 32)


def usage() -> None:
    """Displays usage instructions"""
    print(
        """
script + environmental variables

or

script + json_input (as argument)

environmental variables:

    create:
        JOB_INSTANCE_ID
        SCHEDULE_ID
        RUN_ID
        METHOD
        ANS_VAR_host_ips
       """
    )
    raise SystemExit(4)


if __name__ == "__main__":
    configure_logging()
    main = Main()
    if resolve_method(main.inputargs) == "create":
        main.check_required_inputargs(keys=["host_ips"])
        main.create()
    else:
        usage()
        print(f'method "{resolve_method(main.inputargs)}" not supported!')
        raise SystemExit(4)
